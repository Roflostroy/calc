#!/bin/bash
if [ "$#" -eq 3 ];
then
    p1="$1"
    op="$2"
    p2="$3"
elif [ "$#" -eq 0 ];
then
    echo "Введи переменную 1:"
    read p1

    echo "Введи операцию (+, -, *, /):"
    read op

    echo "Введи переменную 2:"
    read p2
else
    echo "Ошибка: Нужно передать ровно 3 аргумента или не передавать вовсе!"
    echo "Использование: $0 [число1] [операция] [число2]"
    exit 1
fi
if [[ "$p1" =~ ^[0-9]+$ ]]; then
    echo "Переменная 1: Засчитано"
else
    echo "Ошибка: В переменной 1 должно быть число!"
    exit 1
fi
if [[ "$op" == "-" ]];
then
    echo "Вычитаем..."
elif [[ "$op" == "+" ]];
then
    echo "Складываем..."
elif [[ "$op" == "/" ]];
then
    echo "Делим..."
elif [[ "$op" == "*" ]];
then
    echo "Умножаем..."
else
    echo "Ошибка: Символ операции отсутствует или неверен"
    exit 1
fi
if [[ "$p2" =~ ^[0-9]+$ ]]; then
    echo "Переменная 2: Засчитано"
else
    echo "Ошибка: В переменной 2 должно быть число!"
    exit 1
fi

if [[ "$op" == "/" && "$p2" -eq 0 ]];
then
    echo "Ошибка: Деление на ноль невозможно!"
    exit 1
fi

echo "Идет вычисление..."
r=$(($p1"$op"$p2))
echo "Результат: $r"

exit 0
